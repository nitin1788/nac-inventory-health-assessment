# ---------------------------------------------------------
# NAC Inventory Health Assessment — Backend Environment
# Copy this file to .env and fill in real values for local dev.
# NEVER commit the real .env file.
# ---------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=NAC Inventory Assessment <reports@nitinanandconsulting.in>
NAC_LEAD_ALERT_EMAIL=nitinanandconsulting@gmail.com

# CORS — the production domain(s) and localhost:5173 are always allowed
# (see backend/src/config/cors.ts); this var is only for EXTRA origins on
# top of that baseline (e.g. a Vercel preview URL), comma-separated.
CORS_ORIGIN=http://localhost:5173

# Bot protection (Cloudflare Turnstile) - wired in a later milestone
TURNSTILE_SECRET_KEY=
