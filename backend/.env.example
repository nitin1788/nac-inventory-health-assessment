# ---------------------------------------------------------
# NAC Inventory Health Assessment — Backend Environment
# Copy this file to .env and fill in real values for local dev.
# NEVER commit the real .env file.
# ---------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=NAC Inventory Assessment <reports@nitinanandconsulting.in>
NAC_LEAD_ALERT_EMAIL=nitinanandconsulting@gmail.com

# CORS — the production domain(s) and localhost:5173 are always allowed
# (see backend/src/config/cors.ts); this var is only for EXTRA origins on
# top of that baseline (e.g. a Vercel preview URL), comma-separated.
CORS_ORIGIN=http://localhost:5173

# Bot protection (Cloudflare Turnstile) - wired in a later milestone
TURNSTILE_SECRET_KEY=

# TEMPORARY internal testing only — bypasses the payment gateway
# placeholder so report generation/email/download happen immediately
# with no payment step. NEVER set this to true in Render (production).
PAYMENT_TEST_MODE=false

# No real payment gateway is currently configured — the app falls back to
# a safe placeholder provider that never charges anything. A future
# gateway's own credential env vars go here once one is wired in.

# This backend's own public base URL, no trailing slash — generic infra
# config for building a future gateway's redirect/callback URLs. Local dev
# default matches vite's proxy setup; in production set to the Render URL + /api/v1.
BACKEND_BASE_URL=http://localhost:4000/api/v1

# The frontend's public base URL, no trailing slash — generic infra config
# for building a future gateway's final redirect to the Thank You page.
FRONTEND_BASE_URL=http://localhost:5173
