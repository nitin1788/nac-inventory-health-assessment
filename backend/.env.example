# ---------------------------------------------------------
# NAC Inventory Health Assessment — Backend Environment
# Copy this file to .env and fill in real values for local dev.
# NEVER commit the real .env file.
# ---------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=NAC Inventory Assessment <reports@yourdomain.com>
NAC_LEAD_ALERT_EMAIL=nitinanandconsulting@gmail.com

# CORS
CORS_ORIGIN=http://localhost:5173

# Bot protection (Cloudflare Turnstile) - wired in a later milestone
TURNSTILE_SECRET_KEY=

# This backend's own public base URL, no trailing slash — used to build the
# surl/furl PayU redirects back to. Local dev default matches vite's proxy
# setup; in production set to the Render URL + /api/v1.
BACKEND_BASE_URL=http://localhost:4000/api/v1

# The frontend's public base URL, no trailing slash — used to build the
# final redirect to the Thank You page after a PayU callback.
FRONTEND_BASE_URL=http://localhost:5173

# PayU (https://docs.payu.in) — leave both blank to keep the placeholder
# "Payment Gateway Coming Soon" provider active. Get real test credentials
# from the PayU dashboard; never commit real values.
PAYU_KEY=
PAYU_SALT=
# 'test' (default) uses test.payu.in; set to 'production' only once real,
# live PayU credentials are in place and you intend to accept real payments.
PAYU_ENV=test
