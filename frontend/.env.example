# ---------------------------------------------------------
# NAC Inventory Health Assessment — Frontend Environment
# Copy this file to .env and adjust for local dev if needed.
# Only VITE_-prefixed vars are available in client code, and
# everything here is publicly visible in the built bundle.
# ---------------------------------------------------------

# Base path the frontend calls for API requests.
# In dev, Vite proxies /api/* to the local backend (see vite.config.ts).
VITE_API_BASE_URL=/api/v1

# Cloudflare Turnstile site key (public) — wired in a later milestone
VITE_TURNSTILE_SITE_KEY=
