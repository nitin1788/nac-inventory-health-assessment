# ---------------------------------------------------------
# NAC Inventory Health Assessment — Frontend Environment
# Copy this file to .env and adjust for local dev if needed.
# Only VITE_-prefixed vars are available in client code, and
# everything here is publicly visible in the built bundle.
# ---------------------------------------------------------

# Base path/URL the frontend calls for API requests.
# In dev, Vite proxies /api/* to the local backend (see vite.config.ts),
# so the relative default below works as-is.
# In production (Vercel), the frontend and backend are on different
# origins (Vercel + Render) — set this to the full Render backend URL,
# e.g. https://nac-inventory-assessment-api.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1

# Cloudflare Turnstile site key (public) — wired in a later milestone
VITE_TURNSTILE_SITE_KEY=

# WhatsApp community invite link — shown as the "Join WhatsApp Community"
# button on the Thank You page. Get the real invite link from WhatsApp
# (Group/Community info -> Invite via link). Left blank, that button is
# hidden rather than pointing at a fake/placeholder URL.
VITE_WHATSAPP_COMMUNITY_URL=

# Optional override for the "Book Consultation" button's destination.
# Leave blank to use the default wa.me deep link (see
# src/shared/utils/whatsapp.ts), which already prefills a consultation
# request message with the customer's assessment number.
VITE_BOOK_CONSULTATION_URL=

# ---------------------------------------------------------
# ACTION REQUIRED FOR PRODUCTION ANALYTICS
# ---------------------------------------------------------
# Google Analytics 4 Measurement ID. Get this from the GA4 property:
# Admin > Data Streams > (your web stream) > "Measurement ID", format
# "G-XXXXXXXXXX". Left blank here on purpose — do not paste a
# placeholder/fake ID.
#
# Until this is set, src/app/Analytics.tsx loads nothing at all: no
# script tag, no cookies, no network request. Once you provide the real
# ID (in Vercel's project environment variables for production, and
# here for local testing), analytics activates automatically on the
# next deploy/restart — no code change needed.
#
# Also update the "Cookies & Tracking" section of the Privacy Policy
# (src/pages/PrivacyPolicyPage.tsx) once analytics is actually live —
# it currently, and accurately, states no analytics cookies are used.
VITE_GA4_MEASUREMENT_ID=
